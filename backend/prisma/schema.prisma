generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt    @id @default(autoincrement())
  kakaoId      BigInt    @unique @map("kakao_id")
  nickname     String
  profileImage String?   @map("profile_image")
  teamCode     String?   @map("team_code")
  avatarConfig Json?     @map("avatar_config")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSeenAt   DateTime? @map("last_seen_at")

  usages      Usage[]
  attendances Attendance[]

  @@index([teamCode], name: "users_team_code_idx")
  @@index([lastSeenAt], name: "users_last_seen_at_idx")
  @@map("users")
}

model Team {
  code         String @id
  displayName  String @map("display_name")
  primaryColor String @map("primary_color")

  awayGames Game[] @relation("AwayGames")
  homeGames Game[] @relation("HomeGames")

  @@map("teams")
}

model Game {
  id           BigInt   @id @default(autoincrement())
  date         DateTime @db.Date
  startTime    String   @map("start_time")     // "HH:MM" KST
  awayTeamCode String   @map("away_team_code")
  homeTeamCode String   @map("home_team_code")
  venue        String                            // 잠실, 광주, ...
  status       String   @default("-")            // 정적 일정은 "-", 운영 중 라이브 데이터로 갱신 가능
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  awayTeam    Team         @relation("AwayGames", fields: [awayTeamCode], references: [code])
  homeTeam    Team         @relation("HomeGames", fields: [homeTeamCode], references: [code])
  usages      Usage[]
  attendances Attendance[]

  @@unique([date, awayTeamCode, homeTeamCode])
  @@index([date])
  @@map("games")
}

enum UsageKind {
  USE
  RETURN
}

model Usage {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  kind        UsageKind
  qrPayload   String?   @map("qr_payload")
  gameId      BigInt?   @map("game_id")
  stadiumCode String?   @map("stadium_code")
  scannedAt   DateTime  @default(now()) @map("scanned_at")
  lat         Float?
  lng         Float?
  score       Int       @default(0)
  confidence  Float?

  user User  @relation(fields: [userId], references: [id])
  game Game? @relation(fields: [gameId], references: [id])

  @@index([userId, scannedAt], name: "usages_user_scanned_idx")
  @@index([scannedAt], name: "usages_scanned_idx")
  @@index([userId, kind], name: "usages_user_kind_idx")
  @@map("usages")
}

// 경기 선택(=직관 의향). 경기 날짜가 지나도록 취소하지 않으면 직관 방문으로 확정.
// 확정 여부는 별도 컬럼 없이 읽는 시점에 game.date < 오늘 && canceledAt IS NULL 로 계산.
model Attendance {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  gameId     BigInt    @map("game_id")
  selectedAt DateTime  @default(now()) @map("selected_at")
  canceledAt DateTime? @map("canceled_at")

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([userId, canceledAt], name: "attendances_user_canceled_idx")
  @@map("attendances")
}
